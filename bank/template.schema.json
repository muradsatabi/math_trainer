{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math trainer template catalog",
  "type": "object",
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {"const": 1},
    "templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}}
  },
  "$defs": {
    "template": {
      "type": "object",
      "required": ["id", "title", "family", "features", "example", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
        "title": {"type": "string", "minLength": 1},
        "family": {"enum": ["numeric", "literal", "numeric_bracket", "literal_bracket"]},
        "operation": {"enum": ["factor", "expand"], "default": "factor"},
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "example": {"type": "string", "pattern": "^.+→.+$"},
        "status": {"enum": ["active", "deferred", "review"]},
        "methodical_status": {"enum": ["draft", "review", "approved"]},
        "revision": {"type": "integer", "minimum": 1, "default": 1},
        "flat": {"type": "boolean"},
        "parents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_text": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval": {
          "type": "object",
          "required": ["decision", "content_sha256", "source_ref", "approved_by"],
          "anyOf": [{"required": ["approved_at"]}, {"required": ["recorded_at"]}],
          "properties": {
            "decision": {"const": "approved"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_ref": {"type": "string", "minLength": 1},
            "approved_by": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "minLength": 10},
            "recorded_at": {"type": "string", "minLength": 10}
          }
        }
      }
    }
  }
}
